{
  "name": "@house/tokens",
  "version": "0.2.0",
  "private": true,
  "description": "Semantic design tokens: theme.css for the web and a plain token object for React Native.",
  "license": "MIT",
  "bin": {
    "house-check-raw-color": "./bin/check-raw-color.mjs"
  },
  "files": [
    "dist",
    "src/theme.css",
    "src/presets.css",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./tokens": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./theme.css": "./src/theme.css",
    "./presets.css": "./src/presets.css",
    "./check-raw-color": "./bin/check-raw-color.mjs"
  },
  "scripts": {
    "emit": "node scripts/emit-css.ts",
    "build": "node scripts/emit-css.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  }
}
